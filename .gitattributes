# 默认按文本处理，仓库和工作区统一 LF（项目现有文件均为 LF）
* text=auto eol=lf

# Windows 脚本保持 CRLF，避免编辑器改成 LF 后双击出问题
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.vbs   text eol=crlf

# 二进制资源，别做换行/合并处理
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mp3   binary
*.wav   binary
*.db    binary
*.exe   binary
