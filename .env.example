# ===== 脑子 =====
# auto: models/ 里的本地模型 -> Ollama -> API -> 离线
# 可选：auto / hf / ollama / api
FISH_PROVIDER=auto

# 本地 transformers 模型目录。留空则自动用 models/ 下的第一个
# HF_MODEL_DIR=D:\OneDrive\桌面\大肥鱼\models\Qwen2.5-1.5B-Instruct

# 本地 Ollama（如果你能装上）
OLLAMA_BASE=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct

# 在线 API（不填就不走这条）
# API_BASE=https://api.deepseek.com/v1
# API_MODEL=deepseek-chat
# API_KEY=sk-xxxx

# ===== 服务 =====
FISH_HOST=127.0.0.1
FISH_PORT=8765

# ===== 声音 =====
# edge-tts 音色：zh-CN-XiaoyiNeural / zh-CN-XiaoxiaoNeural / zh-CN-YunxiNeural
FISH_VOICE=zh-CN-XiaoyiNeural
# faster-whisper 模型：tiny / base / small / medium
FISH_STT_MODEL=small

# 语音引擎：edge = 微软 edge-tts（免费）；breeze = BreezeBlue 云端（要 API Key，按字符计费）
FISH_TTS=edge
# 用 BreezeBlue 时填这几个；不带 key 就自动退回 edge-tts
# BREEZE_API_KEY=brz_xxxxxxxxxxxxxxxx
# 「大肥鱼 · 迷糊版」
# BREEZE_VOICE_ID=voc_8yud7hz7c9q2
# BREEZE_MODEL_ID=breeze-tts-2
# BREEZE_LANGUAGE=zh
# 可选的表演指令，留空就用音色本身的默认语气
# BREEZE_INSTRUCTIONS=声音低一点、软一点，带一点气声，像刚睡醒还没力气；不要尖、不要亮。语速正常，别拖长音。
# 越高越听 instructions（1~10）
# BREEZE_GUIDANCE=5
# 语速（0.5~2.0）；注意 Breeze 调快时音调也会跟着上去，想「软」主要靠 instructions 和 PITCH
# BREEZE_SPEED=1.0
# 后期降调（0.85~1.0），0.93 大约低一个半音；1.0 = 不降调（第一版）。非 1.0 会改用 WAV
# BREEZE_PITCH=1.0
# 统一响度：Breeze 每次生成的音量会飘，开启后拉到 -18 dBFS，避免某条特别小声
# BREEZE_NORMALIZE=1
# BREEZE_TARGET_DBFS=-18

# ===== QQ 上的语音条和表情包 =====
# 0 = 关掉。网页界面的「语音回复」不受这两个影响
FISH_VOICE_REPLY=1
FISH_STICKER_REPLY=1
# 表情包目录；留空 = 项目下的 stickers/，一个类别一个文件夹
# FISH_STICKER_DIR=D:\OneDrive\桌面\大肥鱼\stickers
# 每个会话每天最多几条 / 两次至少隔几秒（你明确要的那次不受间隔限制，每天总量照算）
FISH_VOICE_MAX=6
FISH_VOICE_GAP=120
FISH_STICKER_MAX=12
FISH_STICKER_GAP=90
# 把她 QQ 账号「收藏」里的表情也同步下来，按标签/随机发
FISH_QQ_FACES=1
# 多久去 NapCat 看一眼收藏有没有变（分钟）
FISH_QQ_FACES_MIN=10

# ===== 记忆 =====
FISH_MEMORY_WINDOW=16
FISH_SUMMARY_AFTER=30
# 记忆流：经历按遗忘曲线变淡，想起来变牢，快忘了先记模糊（0 = 关掉，只剩摘要 + 事实）
FISH_MEMORY_STREAM=1
# 每次聊天最多想起几条以前的事
FISH_RECALL_K=3
# 多久整理一次（记模糊 / 合并 / 遗忘），单位小时
FISH_TIDY_HOURS=3

# ===== 她自己会变 =====
# 人格文件末尾有一小段是她自己的：隔一阵子照着最近的经历加一条 / 改一条 / 删一条。
# 0 = 关掉，她就一直是现在这样
FISH_SELF_EDIT=1
# 多久才想一次自己（小时）；到点也要攒够新事才真改
FISH_SELF_EDIT_HOURS=24
# 至少攒够几条新聊天才让她想，免得为一句气话改自己
FISH_SELF_EDIT_MIN=4

# ===== 她的窗（可选） =====
# 填城市名，她就知道外面天黑没黑、什么月亮、下没下雨；不填就只知道几点
# FISH_CITY=上海
# 也可以直接填坐标，省一次地理编码
# FISH_LAT=31.23
# FISH_LON=121.47

# ===== 她会自己找你说话（QQ 私聊 + 网页界面，不发群） =====
# 0 = 关掉。默认开着，但一天几条、只在你没说话的时候
FISH_PROACTIVE=1
# 每天最多几条（补话也算在里面）
FISH_PROACTIVE_MAX=3
# 两次主动之间至少隔几小时
FISH_PROACTIVE_GAP=3
# 你多久没说话，她才会想起来找你（小时）
FISH_PROACTIVE_IDLE=3
# 补一句：你聊到一半没接话，她过多久自己补一句（分钟）
# 在 [IDLE, IDLE + WINDOW] 这个范围里随机挑时刻，不会掐着表
FISH_FOLLOW=1
FISH_FOLLOW_IDLE=15
FISH_FOLLOW_WINDOW=25
# 一天最多补几句
FISH_FOLLOW_MAX=2
# 免打扰时段，23-8 表示 23 点至次日 8 点
FISH_QUIET=23-8

# 早晚定时问候（各一条，在窗口里随机挑个时刻发；0 = 只留随口找你那种）
FISH_SLOTS=1
FISH_MORNING=08:00
FISH_NIGHT=22:00
# 窗口多少分钟：8:00 + 60 = 8:00~9:00 之间随机
FISH_SLOT_WINDOW=60

# ===== 群里说话 =====
# 被 @ 时一定回；下面这组是「没 @ 也会自己接一句」
FISH_GROUP_AT_ONLY=1
FISH_GROUP_CHAT=1
# 群里正聊着的时候，她自己插一句（不等人点名）
FISH_GROUP_CHIME=1
# 只在这些群生效（逗号分隔群号）；留空 = 所有群
FISH_GROUP_ALLOW=
# 限流：同一群每小时最多几句 / 两次至少隔几分钟 / 每天最多几句
FISH_GROUP_MAX_HOUR=6
FISH_GROUP_GAP=3
FISH_GROUP_MAX_DAY=15
# 刷屏群每秒最多判断几条
FISH_GROUP_RATE=6

# ===== QQ（NapCat / OneBot v11 的 HTTP API） =====
QQ_API=http://127.0.0.1:3000
QQ_TOKEN=

# ===== 妹妹（第二个 bot 账号，可选） =====
# 打开之后：sister/ 是她的数据，8766 是她的面板，3001 是她那份 NapCat。
FISH_SISTER=0
# 妹妹的 QQ 号；留空就问她那份 NapCat 要
FISH_SISTER_UIN=
# 鲸鲸自己的 QQ 号；留空就问 3000 那份 NapCat 要（妹妹得知道谁是姐姐）
FISH_SELF_UIN=
# 妹妹那份 NapCat（第二份，端口别跟 3000 撞）
FISH_SISTER_API=http://127.0.0.1:3001
FISH_SISTER_TOKEN=
FISH_SISTER_PORT=8766

# 两个 bot 聊天的刹车：一轮最多几句 / 聊够了歇多久（分钟）/ 一天最多几句
FISH_PEER_MAX=6
FISH_PEER_COOLDOWN=90
FISH_PEER_DAY=120
# 两次回复至少隔几秒（她会随机构思一会儿，加起来像真人打字）
FISH_PEER_GAP=6
# 鲸鲸主动找妹妹：开关 / 至少隔几小时 / 一天最多几次 / 半夜不找
FISH_PEER_OPEN=1
FISH_PEER_OPEN_GAP=3
FISH_PEER_OPEN_DAY=3
FISH_PEER_QUIET=23-9
# 只跟对面那个 bot 说话（妹妹那份数据自动开；主号一般不用开）
FISH_PEER_ONLY=0

# ===== 微信（第三方桥的回发地址，可选） =====
WECHAT_WEBHOOK=
